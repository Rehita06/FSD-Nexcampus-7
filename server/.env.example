# Copy this file to server/.env and fill it in. Never commit server/.env.
#
# Local MongoDB:   mongodb://127.0.0.1:27017/nexcampus
# MongoDB Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nexcampus?retryWrites=true&w=majority
MONGODB_URI=
PORT=5000

# Optional: comma-separated browser origins allowed to call the API (defaults to localhost only).
# CORS_ORIGIN=https://your-frontend.example.com
