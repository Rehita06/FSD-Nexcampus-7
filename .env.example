# Frontend settings (copy to .env.local if you need to change them).
#
# Leave VITE_API_URL unset in development and when Express serves the built app (same origin, '/api').
# Set it when the frontend and API are hosted separately, e.g. https://nexcampus-api.onrender.com/api
# VITE_API_URL=

# Dev only: where the Vite dev server forwards /api requests (default http://localhost:5000)
# VITE_DEV_API_TARGET=http://localhost:5000
